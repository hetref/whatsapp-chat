# ==============================================================================
# @repo/api (Express Backend) Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="development"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
API_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
API_TRUST_PROXY="false"

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL / NeonDB via Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ------------------------------------------------------------------------------
# AWS S3 MEDIA STORAGE (WhatsApp Media Inbound & Outbound)
# ------------------------------------------------------------------------------
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="your-s3-bucket-name"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT & SUBSCRIPTION GATEWAY
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Subscription Plan IDs created in Razorpay Dashboard
RAZORPAY_SILVER_PLAN_ID="plan_your_silver_plan_id"
RAZORPAY_GOLD_PLAN_ID="plan_your_gold_plan_id"
RAZORPAY_PLAN_ID="plan_your_silver_plan_id"
