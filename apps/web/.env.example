# ==============================================================================
# @repo/web (Next.js Application) Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# BETTER AUTH CONFIGURATION (Email & Password Authentication)
# ------------------------------------------------------------------------------
# Secret key used for encrypting sessions and cookies (e.g. generated via `openssl rand -hex 32`)
BETTER_AUTH_SECRET="your_better_auth_secret_32_bytes_hex"
# Base URL of the web application
BETTER_AUTH_URL="http://localhost:3000"
# Client-side base URL (optional, falls back to window.location.origin or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL / NeonDB via Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ------------------------------------------------------------------------------
# API BACKEND SERVICE INTEGRATION (Next.js rewrites to Express API)
# ------------------------------------------------------------------------------
# Port 4000 in local dev, or your production API URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# META & WHATSAPP CLOUD API (Embedded Signup & Webhooks)
# ------------------------------------------------------------------------------
# Meta App ID from Meta for Developers dashboard
NEXT_PUBLIC_META_APP_ID="your_meta_app_id"
# WhatsApp Embedded Signup Configuration ID from Meta App dashboard
NEXT_PUBLIC_META_CONFIG_ID="your_meta_config_id"
# Meta App Secret used to exchange embedded signup code for permanent token
META_APP_SECRET="your_meta_app_secret"
# Webhook verification token for WhatsApp Cloud API webhook endpoint (/api/webhook)
VERIFY_TOKEN="your_custom_webhook_verify_token"
# Optional aliases supported by /api/webhook:
# META_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"
# WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token"

# ------------------------------------------------------------------------------
# AWS S3 STORAGE (Media upload & presigned URLs for audio, video, image, doc)
# ------------------------------------------------------------------------------
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="your_s3_bucket_name"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT & SUBSCRIPTION GATEWAY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Subscription Plan IDs created in Razorpay Dashboard
RAZORPAY_SILVER_PLAN_ID="plan_your_silver_plan_id"
RAZORPAY_GOLD_PLAN_ID="plan_your_gold_plan_id"
RAZORPAY_PLAN_ID="plan_your_silver_plan_id"

# ------------------------------------------------------------------------------
# SMTP EMAIL CONFIGURATION (Nodemailer for password resets and Flow submissions)
# Configure these variables in both the web and API service environments.
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
# 16-character Google App Password (without spaces)
SMTP_PASS="your_app_password"
SMTP_FROM="WaChat <your-email@gmail.com>"

# ------------------------------------------------------------------------------
# DEVELOPER API KEY ENCRYPTION
# ------------------------------------------------------------------------------
# 32-character secret key used to encrypt/decrypt user API keys in AES-256
API_KEY_ENCRYPTION_SECRET="your_32_character_encryption_secret_key"

# ------------------------------------------------------------------------------
# DEPRECATED / LEGACY (Preserved for backward-compatibility only)
# Note: Authentication has been migrated to Better Auth; database to NeonDB.
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
# CLERK_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
