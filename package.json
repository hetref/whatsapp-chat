{
    "name": "whatsapp-monorepo",
    "private": true,
    "packageManager": "npm@10.8.2",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
        "dev:web": "turbo dev --filter=@repo/web",
        "dev:api": "turbo dev --filter=@repo/api",
        "start:web": "npm run start --workspace @repo/web",
        "start:api": "npm run start --workspace @repo/api",
        "lint": "turbo lint",
        "check-types": "turbo check-types",
        "db:generate": "turbo run generate --filter=@repo/db",
        "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
        "db:migrate:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
        "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
        "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
        "postinstall": "npm run db:generate"
    },
    "devDependencies": {
        "baseline-browser-mapping": "^2.10.38",
        "concurrently": "^9.2.1",
        "shadcn": "^4.5.0",
        "turbo": "^2.4.4"
    }
}
